{
  "name": "codeflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cd web-ui && npm ci && npm run build && cd ../landing && npm ci && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "generate:tutorial-seed": "node scripts/generate-tutorial-seed.mjs",
    "generate:agent-seed": "node scripts/generate-agent-seed.mjs && node scripts/check-pi-extensions.mjs",
    "measure:seed-tokens": "node scripts/measure-seed-tokens.mjs",
    "compile:operator-package": "node scripts/operator-package/cli.mjs",
    "prebuild": "npm run generate:tutorial-seed && npm run generate:agent-seed",
    "pretest": "npm run generate:tutorial-seed && npm run generate:agent-seed",
    "types:generate": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:worker": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-broken-sourcemaps.js",
    "lint": "oxlint src/ stress/ --deny-warnings",
    "lint:fix": "oxlint src/ stress/ --fix",
    "knip": "knip"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@cloudflare/containers": "^0.3.7",
    "@streamparser/json": "0.0.26",
    "aws4fetch": "^1.0.20",
    "edgepush": "0.1.1",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "glob": ">=11.0.0",
    "undici": "7.30.0",
    "sharp": "0.35.5",
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "5.0.5",
    "agents": "0.28.1",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "knip": "^6.40.0",
    "oxlint": "^1.87.0",
    "typebox": "1.3.36",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.148.0",
    "yaml": "2.9.1"
  }
}
