{
  "name": "codeflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cd web-ui && npm ci && npm run build && cd ../landing && npm ci && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "generate:tutorial-seed": "node scripts/generate-tutorial-seed.mjs",
    "generate:agent-seed": "node scripts/generate-agent-seed.mjs && node scripts/check-pi-extensions.mjs",
    "measure:seed-tokens": "node scripts/measure-seed-tokens.mjs",
    "prebuild": "npm run generate:tutorial-seed && npm run generate:agent-seed",
    "pretest": "npm run generate:tutorial-seed && npm run generate:agent-seed",
    "types:generate": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-broken-sourcemaps.js",
    "lint": "oxlint src/ stress/ --deny-warnings",
    "lint:fix": "oxlint src/ stress/ --fix",
    "knip": "knip"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "glob": ">=11.0.0",
    "esbuild": "$esbuild",
    "@vitest/runner": "4.1.10",
    "@vitest/snapshot": "4.1.10",
    "@vitest/pretty-format": "4.1.10",
    "@vitest/utils": "4.1.10",
    "@vitest/expect": "4.1.10",
    "@vitest/mocker": "4.1.10",
    "@vitest/spy": "4.1.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "esbuild": "0.28.1",
    "fast-check": "^4.9.0",
    "knip": "^6.29.0",
    "oxlint": "^1.75.0",
    "typebox": "1.3.8",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0",
    "yaml": "2.9.0"
  }
}
