{
  "version": 1,
  "manifestMaxBytes": 65536,
  "extensionMaxCount": 50,
  "settingsMaxBytes": 32768,
  "settingValueMaxBytes": 2048,
  "settingObjectMaxDepth": 4,
  "extensionIdPattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*$",
  "extensionVersionPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.].+)?$",
  "extensionVersionMaxLength": 64,
  "targetPlatformPattern": "^[a-z0-9][a-z0-9-]{0,63}$",
  "installedAtPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
  "sha256Pattern": "^[0-9a-f]{64}$",
  "fixedExtensionIds": [
    "anthropic.claude-code",
    "codeflare.codeflare-agent-sidebar",
    "codeflare.codeflare-welcome"
  ],
  "uiStateSettingKeys": [
    "workbench.colorTheme",
    "workbench.iconTheme",
    "workbench.activityBar.location",
    "workbench.sideBar.location",
    "workbench.panel.defaultLocation",
    "workbench.statusBar.visible",
    "window.menuBarVisibility"
  ]
}
