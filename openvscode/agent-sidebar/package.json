{
  "name": "codeflare-agent-sidebar",
  "displayName": "Codeflare Agent Sidebar",
  "description": "Codeflare-owned Pi RPC and Claude PTY sidebar for OpenVSCode Server",
  "version": "0.0.0",
  "publisher": "codeflare",
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.109.0",
    "node": "22.21.1"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:codeflare.agentSidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeflare.agentSidebarContainer",
          "title": "Codeflare Agent",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "codeflare.agentSidebarContainer": [
        {
          "id": "codeflare.agentSidebar",
          "name": "Agent",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "check:dependencies": "node ./scripts/check-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .. agent-sidebar/test claude/test --coverage.enabled --coverage.provider=v8 --coverage.reporter=text",
    "test:report": "vitest run --root .. agent-sidebar/test claude/test --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --reporter=json --outputFile=agent-sidebar/browser-ide-report.json"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@types/vscode": "1.109.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
