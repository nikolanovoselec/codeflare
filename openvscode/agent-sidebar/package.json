{
  "name": "codeflare-agent-sidebar",
  "displayName": "Codeflare",
  "description": "Codeflare native Chat participant for the Browser IDE",
  "version": "0.0.0",
  "publisher": "codeflare",
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.109.0",
    "node": "22.21.1"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*",
    "onChatParticipant:codeflare.pi",
    "onCommand:codeflare.pi.reviewFile"
  ],
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatProvider",
    "defaultChatParticipant"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "copilot",
        "displayName": "Codeflare"
      },
      {
        "vendor": "codeflare",
        "displayName": "Codeflare"
      }
    ],
    "chatParticipants": [
      {
        "id": "codeflare.pi",
        "name": "codeflare",
        "fullName": "Codeflare",
        "description": "Codeflare agent with workspace and editor context.",
        "isDefault": true,
        "isSticky": true,
        "locations": [
          "panel",
          "editor"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ],
    "commands": [
      {
        "command": "codeflare.pi.reviewFile",
        "title": "Review with Codeflare"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codeflare.pi.reviewFile",
          "group": "1_chat@1",
          "when": "resourceScheme == 'file' && !explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "codeflare.pi.reviewFile",
          "group": "1_chat@6",
          "when": "resourceScheme == 'file'"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "check:dependencies": "node ./scripts/check-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=text",
    "test:report": "vitest run --config ./vitest.config.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --reporter=json --outputFile=agent-sidebar/browser-ide-report.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.109.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
