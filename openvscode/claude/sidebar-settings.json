{
  "permissions": {
    "defaultMode": "ask",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node /opt/codeflare/openvscode/claude/pre-tool-use.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_REMOTE_CONTROL": "0"
  }
}
