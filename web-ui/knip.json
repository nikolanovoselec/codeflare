{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/__tests__/helpers/**"],
  "ignoreIssues": {
    "src/chat/upstream/**": ["files", "exports", "types"]
  },
  "ignoreDependencies": ["@testing-library/dom", "@vitest/coverage-v8", "tailwindcss"],
  "rules": {
    "enumMembers": "off"
  },
  "ignoreExportsUsedInFile": true
}
