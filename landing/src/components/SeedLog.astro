---
/**
 * Scaffolding as an annotated seed log: each machine event line (what the
 * session mounts at birth) is annotated by its card body. Index-paired
 * with SEED_LOG; the 'agents' sentinel renders the agent-chip row from
 * AGENTS with a caret after the active one.
 */
import type { Card } from '../content/site';
import { AGENTS, SEED_LOG } from '../content/site';

interface Props {
  entries: Card[];
}

const { entries } = Astro.props;
---

<div class="seedlog">
  {
    entries.map((entry, index) => (
      <div class="seedlog-pair" data-print>
        {SEED_LOG[index] === 'agents' ? (
          <p class="seedlog-line">
            <span class="seedlog-check" aria-hidden="true">
              ✓
            </span>
            agent:
            {AGENTS.map((agent, agentIndex) => (
              <span class:list={['agent-chip', { 'agent-active': agentIndex === 0 }]}>{agent}</span>
            ))}
          </p>
        ) : (
          <p class="seedlog-line">
            <span class="seedlog-check" aria-hidden="true">
              ✓
            </span>
            {SEED_LOG[index].replace(/^✓ /, '')}
          </p>
        )}
        <p class="seedlog-note">
          <strong>{entry.title}.</strong> {entry.body}
        </p>
      </div>
    ))
  }
</div>
