---
import type { SnippetLine } from '../content/site';

interface Props {
  label: string;
  lines: SnippetLine[];
}

const { label, lines } = Astro.props;
---

<div class="snippet reveal" aria-label={label}>
  {
    lines.map((line) => (
      <span class="snippet-line">
        {line.ok && <span class="t-ok">✓</span>}
        {line.strong && <span class="t-hl">{line.strong}</span>}
        {line.text}
      </span>
    ))
  }
</div>
