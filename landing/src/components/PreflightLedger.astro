---
/**
 * The hero's boot-assertion block: the four facts that used to be a stat
 * strip, printed as preflight checks before the session shows its prompt —
 * which is itself the security story. Figures stay inline at body scale.
 */
import { HERO, STATS } from '../content/site';

const keyWidth = Math.max(...STATS.map((stat) => stat.key.length));
---

<div class="preflight" aria-label="Session preflight checks">
  <p class="preflight-motd">{HERO.motd}</p>
  {
    STATS.map((stat) => (
      <p class="preflight-line" data-print>
        <span class="preflight-check" aria-hidden="true">
          ✓
        </span>
        <span class="preflight-key">{stat.key.padEnd(keyWidth, ' ')}</span>
        <span class="preflight-fact">
          <strong>{stat.value}</strong> {stat.label}
        </span>
      </p>
    ))
  }
</div>
