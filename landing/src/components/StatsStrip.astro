---
import type { Stat } from '../content/site';

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stats reveal">
  {
    stats.map((stat) => (
      <div class="stat">
        <span class="stat-value">{stat.value}</span>
        <span class="stat-label">{stat.label}</span>
      </div>
    ))
  }
</div>
