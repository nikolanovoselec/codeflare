---
/**
 * ASCII box-drawing diagram of the data path: browser → Access/IdP →
 * ephemeral container → interception → your AI Gateway. Authored ≤38ch so
 * it never overflows a 360px viewport. aria-hidden with a visually-hidden
 * prose twin; the callouts point at deliberately empty space — the parts
 * of the architecture that aren't there.
 */
import { BOUNDARY } from '../content/site';
---

<figure class="boundary">
  <pre class="boundary-diagram" aria-hidden="true" data-print>{BOUNDARY.diagram.join('\n')}</pre>
  <p class="visually-hidden">{BOUNDARY.proseTwin}</p>
  <figcaption class="boundary-callouts" aria-hidden="true">
    {BOUNDARY.callouts.map((callout) => <span class="boundary-callout">⌐ {callout}</span>)}
  </figcaption>
</figure>
