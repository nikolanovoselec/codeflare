---
/**
 * The session's section grammar, replacing the eyebrow: a dim elapsed-time
 * stamp, the prompt glyph, a scrollback path or real command, and a
 * right-aligned instrument readout that only this section can claim.
 * The scrollspy lights the glyph while the section is active.
 */
import type { SectionPrompt } from '../content/site';

interface Props {
  prompt: SectionPrompt;
}

const { prompt } = Astro.props;
---

<p class="prompt-label" data-spy>
  <span class="prompt-stamp" aria-hidden="true">{prompt.stamp}</span>
  <span class="prompt-glyph" aria-hidden="true">❯</span>
  <span class="prompt-line">{prompt.line}</span>
  <span class="prompt-readout">{prompt.readout}</span>
</p>
