---
/**
 * The Shift rendered as a diff: each coding-assistant point is a deletion
 * row, its engine counterpart the addition directly beneath. One pair-
 * aligned source (build-diff) drives both the unified (mobile) and split
 * (desktop) renderings via CSS — the comparison can never drift between
 * breakpoints. Deletions reveal deliberately slow, additions land fast:
 * the timing difference IS the argument.
 */
import { SHIFT } from '../content/site';
import { buildDiff } from '../scripts/build-diff';

const diff = buildDiff(SHIFT.assistant, SHIFT.engine);
const pairs = SHIFT.assistant.points.map((_, pairIndex) =>
  diff.filter((line) => line.pairIndex === pairIndex)
);
---

<div class="diff" id="shift-diff" role="table" aria-label={`${SHIFT.assistant.title} versus ${SHIFT.engine.title}`}>
  <div class="diff-hunk" aria-hidden="true">@@ coding-assistant → agentic-coding-engine @@</div>
  {
    pairs.map((pair) => (
      <div class="diff-pair" role="row">
        {pair.map((line) => (
          <p class={`diff-line diff-${line.sign === '-' ? 'del' : 'add'}`} role="cell">
            <span class="diff-sign" aria-hidden="true">
              {line.sign}
            </span>
            <span class="diff-text">{line.text}</span>
          </p>
        ))}
      </div>
    ))
  }
</div>

<script>
  import { inView, animate, stagger } from 'motion';

  const EASE_OUT_STRONG: [number, number, number, number] = [0.23, 1, 0.32, 1];
  const diffEl = document.getElementById('shift-diff');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (diffEl && !prefersReduced) {
    inView(
      diffEl,
      () => {
        const pairs = [...diffEl.querySelectorAll<HTMLElement>('.diff-pair')];
        pairs.forEach((pair, index) => {
          const del = pair.querySelector<HTMLElement>('.diff-del');
          const add = pair.querySelector<HTMLElement>('.diff-add');
          const offset = index * 0.07;
          if (del) {
            // Deliberately sluggish: the human-typing pace.
            animate(
              del,
              { opacity: [0, 1], transform: ['translateY(4px)', 'translateY(0px)'] },
              { duration: 0.24, ease: 'linear', delay: offset }
            );
            window.setTimeout(() => del.classList.add('diff-struck'), (offset + 0.12) * 1000);
          }
          if (add) {
            // The engine lands fast.
            animate(
              add,
              { opacity: [0, 1], transform: ['translateY(4px)', 'translateY(0px)'] },
              { duration: 0.18, ease: EASE_OUT_STRONG, delay: offset + 0.18 }
            );
          }
        });
      },
      { margin: '-80px' }
    );
  }
</script>
