---
/**
 * Hero: positioning line, the headline, a short sub, two CTAs, and one
 * legible static terminal showing a real Codeflare session (feature built,
 * tested, reviewed, shipped through the pipeline, container destroyed).
 */
import { HERO, TERMINAL } from '../content/site';
---

<header class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-fluid" data-flare-fluid aria-hidden="true"></div>
  <div class="container">
    <p class="kicker">{HERO.kicker}</p>
    <h1>
      {HERO.headline.plain}<br />
      <span class="flare" data-scramble>{HERO.headline.flare}</span>
    </h1>
    <p class="hero-sub">{HERO.sub}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={HERO.primaryCta.href}>{HERO.primaryCta.label}</a>
      <a class="btn btn-ghost" href={HERO.secondaryCta.href}>{HERO.secondaryCta.label}</a>
    </div>

    <div class="hero-terminal reveal">
      <div class="terminal">
        <div class="terminal-bar">
          <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="terminal-title">{TERMINAL.title}</span>
        </div>
        <div class="terminal-body">
          {TERMINAL.lines.map((line) => <span class={`t-line t-${line.tone}`}>{line.text}</span>)}
          <span class="t-line t-cmd"><span class="t-caret" aria-hidden="true"></span></span>
        </div>
      </div>
    </div>
  </div>
</header>
