---
/**
 * Hero: positioning line, the headline, a short sub, two CTAs, and one
 * legible static terminal showing a real Codeflare session (feature built,
 * tested, reviewed, shipped through the pipeline, container destroyed).
 */
import { HERO, TERMINAL, SPINE } from '../content/site';
---

<header class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container">
    <p class="kicker">{HERO.kicker}</p>
    <h1>
      {HERO.headline.plain}<br />
      <span class="flare" data-scramble>{HERO.headline.flare}</span>
    </h1>
    <p class="hero-sub">{HERO.sub}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={HERO.primaryCta.href}>{HERO.primaryCta.label}</a>
      <a class="btn btn-ghost" href={HERO.secondaryCta.href}>{HERO.secondaryCta.label}</a>
    </div>

    <div class="hero-terminal reveal">
      <div class="terminal" data-proof>
        <div class="terminal-bar">
          <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="terminal-title">{TERMINAL.title}</span>
        </div>
        <div class="terminal-body">
          {TERMINAL.lines.map((line, i) => <span class={`t-line t-${line.tone}`} style={`--i:${i}`}>{line.text}</span>)}
          <span class="t-line t-cmd" style={`--i:${TERMINAL.lines.length}`}><span class="t-caret" aria-hidden="true"></span></span>
        </div>
        <!-- Coding-agent statusline: context / model / reasoning, gently animated
             (context ticks, an occasional compaction beat) by agentfoot.ts;
             static and fully legible without JS and under reduced motion. -->
        <div class="terminal-foot" data-agentfoot>
          <span class="tf-seg tf-ctx"><span class="tf-dot" aria-hidden="true"></span><span data-tf-ctx>{TERMINAL.foot.ctx}</span></span>
          <span class="tf-seg">{TERMINAL.foot.model}</span>
          <span class="tf-seg" data-tf-reason>{TERMINAL.foot.reason}</span>
          <span class="tf-seg tf-note">{TERMINAL.foot.note}</span>
        </div>
      </div>
      <!-- The spine as the page's quiet table of contents: one run, named once,
           that every proof artifact below is a camera angle on. -->
      <div class="hero-spine" aria-hidden="true">
        <span class="hero-spine-id">{SPINE.req}</span>
        <span class="hero-spine-step">spec</span>
        <span class="hero-spine-step">build</span>
        <span class="hero-spine-step">prove</span>
        <span class="hero-spine-step">ship</span>
        <span class="hero-spine-id">{SPINE.pr}</span>
      </div>
    </div>
  </div>
</header>
