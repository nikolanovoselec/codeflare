---
/**
 * One satellite fleet pane: mono title bar with repo + tenancy badge, a
 * compressed transcript, and a dim attribution footer line. Rendered
 * complete in static HTML; the fleet scheduler replays it after the split.
 * aria-hidden while playing — only the hero pane is a live region.
 */
import type { FleetPane } from '../content/site';

interface Props {
  pane: FleetPane;
  index: number;
}

const { pane, index } = Astro.props;
---

<div class="session-pane" data-pane={index}>
  <div class="session-pane-bar">
    <span class="session-pane-title">{pane.title}</span>
    <span class="session-pane-badge">{pane.badge}</span>
  </div>
  <div class="session-pane-body">
    {
      pane.lines.map((line) => (
        <span data-fleet={line.kind} data-wait={line.waitMs} class={`t-${line.tone}`}>
          {line.text}
        </span>
      ))
    }
  </div>
</div>
