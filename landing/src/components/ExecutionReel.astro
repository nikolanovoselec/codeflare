---
/**
 * Canonical Execution reel. Each side composes the shared Terminal + Transcript
 * feed, and proof.ts rolls five realistic events through a full five-line
 * viewport. The permanent side-by-side composition stacks only on mobile.
 */
import { EXECUTION } from '../content/site';
import ExecutionRun from './ExecutionRun.astro';
---

<div
  class="execution-reel"
  data-execution-reel
  data-readme-reel="execution"
>
  <div class="execution-stage">
    <div class="execution-card">
      <ExecutionRun name="software" run={EXECUTION.software} />
      <ExecutionRun name="infrastructure" run={EXECUTION.infrastructure} />
    </div>
  </div>
</div>
