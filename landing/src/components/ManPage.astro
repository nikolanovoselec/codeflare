---
/**
 * Zero-footprint section as a man page: NAME, SYNOPSIS (with the device
 * row demonstrating fleet supervision on any screen), and the four claims
 * as man-page entries. Simple CSS device frames — no images, no shared
 * scaled markup, just three bordered rects with the same mono readout.
 */
import type { Card } from '../content/site';
import { MAN_PAGE } from '../content/site';

interface Props {
  entries: Card[];
}

const { entries } = Astro.props;
---

<div class="manpage" data-print>
  <p class="manpage-header" aria-hidden="true">
    <span>{MAN_PAGE.header}</span>
    <span>{MAN_PAGE.header}</span>
  </p>

  <p class="manpage-section">NAME</p>
  <p class="manpage-body manpage-name">{MAN_PAGE.name}</p>

  <p class="manpage-section">SYNOPSIS</p>
  <p class="manpage-body"><code>{MAN_PAGE.synopsis}</code></p>

  <div class="device-row" aria-label="The same session, supervised from any device">
    {
      MAN_PAGE.devices.map((device) => (
        <div class={`device device-${device}`}>
          <span class="device-screen">{MAN_PAGE.deviceReadout}</span>
          <span class="device-label">{device}</span>
        </div>
      ))
    }
  </div>

  {
    entries.map((entry) => (
      <div class="manpage-entry">
        <p class="manpage-entry-title">{entry.title}</p>
        <p class="manpage-body">{entry.body}</p>
      </div>
    ))
  }

  <p class="manpage-footer" aria-hidden="true">{MAN_PAGE.footer}</p>
</div>
