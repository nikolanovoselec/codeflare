---
/**
 * The signature artifact: the hero terminal that becomes a fleet.
 *
 * Static HTML always renders the COMPLETE state — full hero transcript and
 * all four panes with their mini transcripts — so crawlers, no-JS visitors,
 * and reduced-motion users read everything. JS (behind the pre-paint
 * html[data-js] flip) collapses the satellites, replays the hero transcript
 * through the unit-tested player, and on the CI-green line commit fires the
 * FLIP split into a working 2×2 fleet (a scroll-snap row under 768px),
 * driven by the deterministic fleet scheduler. The status bar listens for
 * cf-sessions / cf-gateway events. Playback runs once — no loops below the
 * fold (loop hygiene).
 *
 * Only the hero pane is exposed to screen readers; satellite panes are
 * decorative flavor (aria-hidden) demonstrating parallel distinct tasks.
 */
import { FLEET_PANES, TERMINAL_TRANSCRIPT, TERMINAL_WINDOW } from '../content/site';
import SessionPane from './SessionPane.astro';
---

<div class="fleet" id="fleet" data-split="false">
  <div class="terminal session-pane-hero tt-armed" id="hero-terminal">
    <div class="terminal-bar">
      <div class="terminal-dots"><span></span><span></span><span></span></div>
      <span class="terminal-title">{TERMINAL_WINDOW.title}</span>
      <span class="terminal-badge">{TERMINAL_WINDOW.badge}</span>
    </div>
    <div class="terminal-body" aria-label="Demo of an autonomous Codeflare coding session">
      {
        TERMINAL_TRANSCRIPT.map((line) => (
          <span data-tt={line.kind} data-wait={line.waitMs} class={`t-${line.tone}`}>
            {line.text}
          </span>
        ))
      }
    </div>
  </div>
  <div class="fleet-satellites" aria-hidden="true">
    {FLEET_PANES.map((pane, index) => <SessionPane pane={pane} index={index + 1} />)}
  </div>
</div>

<script>
  import { animate, stagger } from 'motion';
  import {
    playTranscript,
    DEFAULT_TIMINGS,
    type PlayerAdapter,
    type TerminalLine,
  } from '../scripts/terminal-player';
  import { buildSceneScript } from '../scripts/scene-script';
  import { schedulePanes } from '../scripts/fleet-scheduler';
  import { flipTransform } from '../scripts/flip-transform';
  import { FLEET_PANES, REQUEST_COUNT, TERMINAL_TRANSCRIPT } from '../content/site';

  const EASE_OUT_STRONG: [number, number, number, number] = [0.23, 1, 0.32, 1];
  const EASE_IN_OUT_STRONG: [number, number, number, number] = [0.77, 0, 0.175, 1];
  const SPLIT_VIEWPORT_GATE = 0.4;

  const fleet = document.getElementById('fleet');
  const hero = document.getElementById('hero-terminal');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const emit = (name: string, detail: number) =>
    window.dispatchEvent(new CustomEvent(name, { detail }));

  if (fleet && hero && !prefersReduced) {
    const sceneScript = buildSceneScript(TERMINAL_TRANSCRIPT, REQUEST_COUNT);
    const heroLines = [...hero.querySelectorAll<HTMLElement>('[data-tt]')];
    const heroTexts = heroLines.map((el) => el.textContent ?? '');
    const satellites = [...fleet.querySelectorAll<HTMLElement>('.session-pane')];
    const fleetLines = satellites.map((pane) => [...pane.querySelectorAll<HTMLElement>('[data-fleet]')]);

    // Track hero visibility for the split gate and pause playback offscreen.
    let heroRatio = 0;
    const ratioWatcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          heroRatio = entry.intersectionRatio;
        }
      },
      { threshold: [0, 0.2, SPLIT_VIEWPORT_GATE, 0.6] }
    );
    ratioWatcher.observe(hero);

    /** Reveal one satellite line with a brief print/type effect. */
    const revealFleetLine = (el: HTMLElement) => {
      el.classList.add('tt-visible');
      animate(
        el,
        { opacity: [0, 1], transform: ['translateY(4px)', 'translateY(0px)'] },
        { duration: 0.18, ease: EASE_OUT_STRONG }
      );
    };

    /** Post-split fleet playback: deterministic interleaved schedule. */
    const playFleet = () => {
      const desktop = window.matchMedia('(min-width: 768px)').matches;
      const panes: TerminalLine[][] = FLEET_PANES.map((pane) => pane.lines);
      const events = schedulePanes(panes, DEFAULT_TIMINGS, {
        maxConcurrentTypers: desktop ? 2 : 1,
      });
      for (const event of events) {
        const el = fleetLines[event.pane]?.[event.line];
        if (el) {
          window.setTimeout(() => revealFleetLine(el), event.at);
        }
      }
      const total = events.at(-1)!;
      window.setTimeout(() => emit('cf-sessions', 4), total.at + total.duration);
    };

    /** The split: FLIP the hero into its cell, reveal the satellites. */
    let splitDone = false;
    const split = (animated: boolean) => {
      if (splitDone) {
        return;
      }
      splitDone = true;

      const first = hero.getBoundingClientRect();
      fleet.dataset.split = 'true';

      if (!animated) {
        for (const lines of fleetLines) {
          for (const el of lines) {
            el.classList.add('tt-visible');
          }
        }
        emit('cf-sessions', 4);
        return;
      }

      const last = hero.getBoundingClientRect();
      animate(
        hero,
        { transform: [flipTransform(first, last), 'translate(0px, 0px) scale(1, 1)'] },
        { duration: 0.48, ease: EASE_IN_OUT_STRONG }
      );
      animate(
        satellites,
        {
          opacity: [0, 1],
          clipPath: ['inset(0 100% 0 0)', 'inset(0 0 0 0)'],
          transform: ['scale(0.96)', 'scale(1)'],
        },
        { duration: 0.32, ease: EASE_OUT_STRONG, delay: stagger(0.09) }
      );
      emit('cf-sessions', 4);
      window.setTimeout(playFleet, 480);
    };

    /** Gateway counter: progressive attribution tally for the status bar. */
    const runGatewayCounter = () => {
      const durationMs = 1200;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / durationMs);
        emit('cf-gateway', Math.round(progress * REQUEST_COUNT));
        if (progress < 1) {
          requestAnimationFrame(tick);
        }
      };
      requestAnimationFrame(tick);
    };

    // Wire the scene script to player line commits.
    const onCommit = (index: number) => {
      for (const action of sceneScript) {
        if (action.line !== index) {
          continue;
        }
        if (action.action === 'split') {
          // Fire only when the hero is sufficiently visible; otherwise the
          // settled fleet state applies silently when it next enters view.
          if (heroRatio >= SPLIT_VIEWPORT_GATE) {
            split(true);
          } else {
            const settle = new IntersectionObserver(
              (entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                  settle.disconnect();
                  split(false);
                }
              },
              { threshold: 0.2 }
            );
            settle.observe(fleet);
          }
        } else if (action.action === 'gw-counter') {
          runGatewayCounter();
        }
      }
    };

    let hovered = false;
    hero.addEventListener('mouseenter', () => {
      hovered = true;
    });
    hero.addEventListener('mouseleave', () => {
      hovered = false;
    });

    const adapter: PlayerAdapter = {
      write: (i, text) => {
        heroLines[i].textContent = text;
      },
      reveal: (i) => {
        heroLines[i].classList.add('tt-visible');
      },
      setCursor: (i, visible) => {
        heroLines[i].classList.toggle('tt-cursor', visible);
      },
      sleep: (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
      // Pause on hover and while the page is hidden (loop hygiene).
      isPaused: () => hovered || document.hidden,
      now: () => Date.now(),
    };
    adapter.onLineCommit = onCommit;

    const lines: TerminalLine[] = heroLines.map((el, i) => ({
      kind: (el.dataset.tt ?? 'line') as TerminalLine['kind'],
      text: heroTexts[i],
      waitMs: Number(el.dataset.wait ?? 0) || undefined,
    }));

    // Single playback pass: type the session, split, work the fleet, stop.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          io.disconnect();
          // Lines keep their full text (the player only re-writes cmd/spin
          // kinds); visibility is gated by tt-visible while armed.
          for (const el of heroLines) {
            el.classList.remove('tt-visible');
          }
          void playTranscript(lines, adapter, DEFAULT_TIMINGS).then(() => {
            // Restore exact text in case a write pass was interrupted.
            heroLines.forEach((el, i) => {
              el.textContent = heroTexts[i];
            });
          });
        }
      },
      { threshold: 0.3 }
    );
    io.observe(hero);
  }
</script>
