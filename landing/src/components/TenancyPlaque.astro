---
/**
 * The tenancy plaque: the page's one indulgence — a masked flare-gradient
 * border (static; the brand energy drawn literally as a boundary) around
 * the sovereignty statement and a four-line setup-wizard transcript.
 */
import { TENANCY } from '../content/site';
---

<div class="plaque" data-print>
  <p class="plaque-lead" set:html={TENANCY.lead} />
  <div class="plaque-setup" aria-label="Setup wizard output">
    {TENANCY.setup.map((line) => <span class="plaque-line">{line}</span>)}
    <span class="plaque-close">{TENANCY.setupClose}</span>
  </div>
</div>
