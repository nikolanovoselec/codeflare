---
import type { CostLayer } from '../content/site';

interface Props {
  layers: CostLayer[];
}

const { layers } = Astro.props;
---

<div class="layers">
  {
    layers.map((layer) => (
      <div class="layer reveal">
        <h3>{layer.name}</h3>
        <p>{layer.body}</p>
      </div>
    ))
  }
</div>
