---
// Fonts are imported by tokens.css (the single design control panel),
// which global.css pulls in first.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Search-indexing directive. Omitted on indexable pages; the login page
   *  passes "noindex, nofollow" so auth URLs (with ?status / ?error) stay out
   *  of search results. */
  robots?: string;
}

// REQ-LANDING-003: the landing page carries the canonical external metadata
// for the enterprise positioning. og.png is served from the SPA asset root.
const {
  title = 'Codeflare: The Enterprise Agentic Coding Engine',
  description = 'This is not a coding assistant. Codeflare is the enterprise agentic coding engine: autonomous agents that build, review, test, and ship inside your cloud boundary, governed, attributed, and encrypted.',
  canonical = 'https://codeflare.ch/',
  robots,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Codeflare" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://codeflare.ch/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Codeflare: the enterprise agentic coding engine." />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://codeflare.ch/og.png" />
    <meta name="twitter:image:alt" content="Codeflare: the enterprise agentic coding engine." />
  </head>
  <body>
    <!-- Page-wide flare-fluid signature: the WebGL canvas is injected here and a
         readability veil sits above it, behind all content (desktop + fine
         pointer only; splash.ts adds html.flare-on once it mounts). -->
    <div class="flare-field" data-flare-fluid aria-hidden="true"></div>
    <slot />
    <script>
      // Hero accent-word scramble (perpetual four-phase idle loop; reduced-motion safe).
      import '../scripts/scramble';
    </script>
    <script>
      // Coding-agent statusline foot: slow context tick + an occasional compaction
      // beat on the hero terminal (reduced-motion safe; the static foot otherwise).
      import '../scripts/agentfoot';
    </script>
    <script>
      // Feature-terminal live prompts: each tile's command line types/deletes a
      // short command in a loop, staggered; one tile just blinks (reduced-motion
      // safe; the static first prompt otherwise).
      import '../scripts/feature-terminals';
    </script>
    <script>
      // Page-wide flare-fluid signature (WebGL; desktop pointers only, reduced-motion safe).
      import '../scripts/splash';
    </script>
    <script>
      // Proof artifacts (enforcement loop, review board, boundary path, ledger):
      // plays each one's CSS sequence once when it scrolls into view. Content is
      // fully legible without it (static final state); reduced-motion shows the
      // final state instantly.
      import '../scripts/proof';
    </script>
    <script>
      // Orchestration station: ticks each agent's tool-use / token counters and
      // advances its activity line so the "Running N agents" view reads as a live
      // feed. Pauses off-screen and when the tab is hidden (reduced-motion safe;
      // the resolved counters and first activity stand otherwise).
      import '../scripts/orch';
    </script>
    <script>
      // Entrance wiring: .reveal elements fade up on first view. Content is
      // visible by default; JS applies the hidden state and immediately
      // animates, never a CSS opacity:0 default (no-JS and reduced-motion
      // visitors see everything).
      import { inView, animate } from 'motion';

      const EASE_OUT_STRONG: [number, number, number, number] = [0.23, 1, 0.32, 1];
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReduced && 'IntersectionObserver' in window) {
        // Each element reveals exactly once. Motion's inView re-fires its
        // callback every time an element re-enters the viewport; without this
        // guard, scrolling up then down re-ran the entrance (blank to visible),
        // which read as a flash on mobile. The WeakSet makes the reveal one-shot
        // and we disconnect the observer after it fires.
        const revealed = new WeakSet<HTMLElement>();

        for (const el of document.querySelectorAll<HTMLElement>('.reveal')) {
          const stop = inView(
            el,
            () => {
              if (revealed.has(el)) return;
              revealed.add(el);
              animate(
                el,
                { opacity: [0, 1], transform: ['translateY(12px)', 'translateY(0px)'] },
                { duration: 0.4, ease: EASE_OUT_STRONG }
              );
              stop?.();
            },
            { margin: '-60px' }
          );
        }

        // Grids cascade their children in (a short stagger) instead of fading as
        // one block. Children are hidden synchronously on enter, then animated.
        // Also one-shot, for the same reason.
        for (const grid of document.querySelectorAll<HTMLElement>('[data-stagger]')) {
          const items = Array.from(grid.children) as HTMLElement[];
          const stop = inView(
            grid,
            () => {
              if (revealed.has(grid)) return;
              revealed.add(grid);
              for (const item of items) item.style.opacity = '0';
              items.forEach((item, i) => {
                animate(
                  item,
                  { opacity: [0, 1], transform: ['translateY(12px)', 'translateY(0px)'] },
                  { duration: 0.4, ease: EASE_OUT_STRONG, delay: i * 0.06 }
                );
              });
              stop?.();
            },
            { margin: '-60px' }
          );
        }
      }

      // The sticky nav gains a depth seam once scrolled past the hero top (a
      // movement-free state toggle, safe under reduced motion).
      const nav = document.querySelector('.site-nav');
      let ticking = false;
      const syncScroll = () => {
        const y = window.scrollY;
        if (nav) nav.classList.toggle('is-scrolled', y > 12);
        ticking = false;
      };
      const requestSync = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(syncScroll);
        }
      };
      window.addEventListener('scroll', requestSync, { passive: true });
      syncScroll();
    </script>
  </body>
</html>
