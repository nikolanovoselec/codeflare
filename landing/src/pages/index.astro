---
/**
 * The Codeflare enterprise landing page: one governed run threaded across the
 * whole page. A single pull request (the spine, REQ-PAY-014 / AC3 / PR #207)
 * is followed from intent to merge, and the proof artifacts are camera angles
 * on it: the hero terminal opens it, the enforcement gate catches it drifting,
 * the boundary + egress strip show where its traffic may go, the context pipe
 * shows how it reads the web safely, the review board judges it in parallel,
 * and the cost ledger is its bill closing on zero unattributed. Governance
 * carries the page; the platform capability lands afterwards as the payoff the
 * boundary makes safe. Calm, sans prose, mono for proof, mobile-first.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { APP_LINKS } from '../config';
import {
  NAV_LINKS,
  AGENTS,
  SPINE,
  STATS,
  SHIFT,
  METHOD,
  SECURITY,
  BOUNDARY_FLOW,
  BOUNDARY_BLOCKED,
  EGRESS,
  OPERATIONS,
  BROWSER,
  PLATFORM,
  CONTEXT,
  PIPELINE,
  COST,
  TENANCY,
  FAQ_SECTION,
  FAQ_ITEMS,
  CONTACT_FORM,
} from '../content/site';
---

<BaseLayout>
  <nav class="site-nav">
    <div class="container">
      <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"></span>codeflare</a>
      <div class="nav-right">
        <ul class="nav-links">
          {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <a class="btn btn-ghost btn-sm nav-signin" href={APP_LINKS.signIn}>Sign in</a>
      </div>
    </div>
  </nav>

  <main id="top">
    <Hero />

    <!-- Stat band: the run in four instrument readings; the AI Gateway 100%
         leads and carries the one coral governance tick. -->
    <section class="section section--alt">
      <div class="container">
        <div class="stats" data-stagger>
          {
            STATS.map((stat) => (
              <div class:list={['stat', { 'is-anchor': stat.anchor }]}>
                <span class="stat-cap">{stat.cap}</span>
                <div class="stat-value">{stat.value}</div>
                <p class="stat-label">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The shift -->
    <section id={SHIFT.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <h2>{SHIFT.title}</h2>
          <p class="lead" set:html={SHIFT.lead} />
        </div>
        <div class="compare reveal">
          <div class="compare-col is-old">
            <h3>{SHIFT.assistant.title} <span class="compare-tag">{SHIFT.assistant.tag}</span></h3>
            <ul class="compare-list">{SHIFT.assistant.points.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="compare-col is-new">
            <h3>{SHIFT.engine.title} <span class="compare-tag">{SHIFT.engine.tag}</span></h3>
            <ul class="compare-list">{SHIFT.engine.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Station 1, Method: spec-driven development, enforced. The gate (the
         receipt) precedes the prose, and the three pillars read as numbered
         clauses of a control, not a feature-card grid. -->
    <section id={METHOD.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{METHOD.kicker}</p>
          <h2>{METHOD.title}</h2>
          <p class="lead">{METHOD.lead}</p>
        </div>
        <!-- Self-healing enforcement gate: a drift caught and corrected at the PR
             boundary. Static markup is the resolved state; data-proof replays the
             fail -> correct -> pass sequence once on scroll-in. The only place an
             agent visibly fails, which is the point. -->
        <div class="gate reveal" data-proof>
          <div class="gate-head">
            <span class="gate-req">{METHOD.gate.req}</span>
            <span class="gate-crit">{METHOD.gate.criterion}</span>
            <span class="gate-pr">{METHOD.gate.pr}</span>
          </div>
          <div class="gate-steps">
            {
              METHOD.gate.steps.map((step, i) => (
                <div class:list={['gate-step', `is-${step.state}`]} style={`--i:${i}`}>
                  <span class="gate-actor">{step.actor}</span>
                  <span class="gate-state">
                    {step.state === 'fail' ? 'failed' : step.state === 'work' ? 'correcting' : 'passed'}
                  </span>
                  <span class="gate-text">{step.text}</span>
                </div>
              ))
            }
          </div>
        </div>
        <p class="gate-caption reveal">{METHOD.gate.caption}</p>
        <ol class="method-clauses" data-stagger>
          {
            METHOD.pillars.map((card) => (
              <li>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Station 2, Security: zero trust is the architecture. The boundary
         data-path and the denied paths beside it carry equal weight; the egress
         strip below turns DLP and guardrails into auditable evidence. -->
    <section id={SECURITY.id} class="section">
      <div class="container">
        <div class="split">
          <div class="section-head reveal" style="margin-bottom:0">
            <p class="kicker">{SECURITY.kicker}</p>
            <h2>{SECURITY.title}</h2>
            <p class="lead">{SECURITY.lead}</p>
            <p class="micro-cta">
              <a href="#contact" data-topic="security-compliance">{SECURITY.microCta}</a>
            </p>
          </div>
          <div class="split-aside reveal">
            <!-- Boundary data-path: the approved route lights stage by stage on
                 scroll-in (data-proof); the denied paths name what the
                 architecture makes impossible, not merely discouraged. -->
            <div class="flow" data-proof>
              {
                BOUNDARY_FLOW.map((node, i) => (
                  <Fragment>
                    <div class:list={['flow-node', { 'is-accent': node.accent }]} style={`--i:${i}`}>
                      {node.label}
                      <small>{node.sub}</small>
                    </div>
                    {i < BOUNDARY_FLOW.length - 1 && (
                      <div class="flow-arrow" style={`--i:${i}`}>{node.edge && <span>{node.edge}</span>}</div>
                    )}
                  </Fragment>
                ))
              }
            </div>
            <ul class="denied-list" aria-label="What the boundary makes impossible">
              {BOUNDARY_BLOCKED.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <div class="card-grid card-grid--2" data-stagger>
          {
            SECURITY.cards.map((card) => (
              <div class="card">
                <span class="card-tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <!-- Egress-inspection strip: one outbound model call inspected at the
             boundary. Structural twin of the gate; the DLP redaction is the one
             amber beat. data-proof replays the rows once on scroll-in. -->
        <div class="gate egress reveal" data-proof>
          <div class="gate-head">
            <span class="gate-req">egress</span>
            <span class="gate-crit">{EGRESS.call}</span>
          </div>
          <div class="gate-steps">
            {
              EGRESS.rows.map((row, i) => (
                <div class:list={['gate-step', `is-${row.state}`]} style={`--i:${i}`}>
                  <span class="gate-actor">{row.actor}</span>
                  <span class="gate-state">{row.label}</span>
                  <span class="gate-text">{row.text}</span>
                </div>
              ))
            }
          </div>
        </div>
        <p class="gate-caption reveal">{EGRESS.caption}</p>
      </div>
    </section>

    <!-- Station 2b, Operations: the same governed agents, beyond code into
         infrastructure. A quieter coda to Security on the same boundary. -->
    <section id={OPERATIONS.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{OPERATIONS.kicker}</p>
          <h2>{OPERATIONS.title}</h2>
          <p class="lead">{OPERATIONS.lead}</p>
        </div>
        <div class="card-grid card-grid--3" data-stagger>
          {
            OPERATIONS.cards.map((card) => (
              <div class="card">
                <span class="card-tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <p class="section-coda reveal">{OPERATIONS.closing}</p>
      </div>
    </section>

    <!-- Station 3, Context: the open web, rendered clean, never trusted. The
         isolation pipe is a peer-level proof artifact above the detail cards. -->
    <section id={CONTEXT.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{CONTEXT.kicker}</p>
          <h2>{CONTEXT.title}</h2>
          <p class="lead">{CONTEXT.lead}</p>
        </div>
        <div class="context-pipe reveal">
          <div class="flow" data-proof>
            {
              CONTEXT.pipe.map((node, i) => (
                <Fragment>
                  <div class:list={['flow-node', { 'is-accent': node.accent }]} style={`--i:${i}`}>
                    {node.label}
                    <small>{node.sub}</small>
                  </div>
                  {i < CONTEXT.pipe.length - 1 && (
                    <div class="flow-arrow" style={`--i:${i}`}>{node.edge && <span>{node.edge}</span>}</div>
                  )}
                </Fragment>
              ))
            }
          </div>
          <p class="pipe-note">{CONTEXT.pipeNote}</p>
        </div>
        <div class="card-grid card-grid--3" data-stagger>
          {
            CONTEXT.cards.map((card) => (
              <div class="card">
                <span class="card-tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Station 4, Pipeline: the parallel review board. Six specialist agents
         on one diff at once, two catching a finding and re-proving it, all
         converging on one human triage gate. "One engineer, many agents" made
         literal. -->
    <section id={PIPELINE.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <h2>{PIPELINE.title}</h2>
          <p class="lead">{PIPELINE.lead}</p>
        </div>

        <div class="review-board reveal" data-proof>
          <div class="board-pr">
            <span class="board-pr-id">{SPINE.pr} · {SPINE.service}</span>
            <span class="board-pr-trigger">{PIPELINE.trigger}</span>
          </div>
          <div class="board-dispatch" aria-hidden="true">{PIPELINE.dispatch}</div>
          <div class="board-lanes">
            {
              PIPELINE.lanes.map((lane, i) => (
                <div class:list={['board-lane', `is-${lane.result}`]} style={`--i:${i}`}>
                  <span class="lane-agent">{lane.agent}</span>
                  <span class="lane-track" aria-hidden="true">
                    <span class="lane-step">queued</span>
                    <span class="lane-step">running</span>
                    {lane.result === 'finding' && <span class="lane-step is-finding">finding</span>}
                    {lane.result === 'finding' && <span class="lane-step is-fixed">fixed</span>}
                    <span class="lane-step is-verified">verified</span>
                  </span>
                  <span class="lane-note">{lane.note}</span>
                </div>
              ))
            }
          </div>
          <div class="board-verdict">
            <span class="verdict-title">{PIPELINE.verdict.title}</span>
            <span class="verdict-note">{PIPELINE.verdict.note}</span>
          </div>
        </div>

        <div class="feature-grid feature-grid--3" data-stagger>
          {
            PIPELINE.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Station 5, Cost: no unattributed dollar. The ledger is the literal bill
         for the spine run, closing on zero unattributed. -->
    <section id={COST.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{COST.kicker}</p>
          <h2>{COST.title}</h2>
          <p class="lead">{COST.lead}</p>
        </div>
        <!-- Attribution ledger: every line carries an owner; the last total
             reads zero unattributed. The rows are a sample of the run; the
             totals cover all of it (the sample note reconciles the two). -->
        <div class="ledger reveal" data-proof>
          <div class="ledger-meta">
            <span class="ledger-meta-id">{COST.ledger.meta}</span>
            <span class="ledger-meta-sample">{COST.ledger.sample}</span>
          </div>
          <div class="ledger-head" aria-hidden="true">
            <span class="lc-time">{COST.ledger.columns[0]}</span>
            <span class="lc-user">{COST.ledger.columns[1]}</span>
            <span class="lc-team">{COST.ledger.columns[2]}</span>
            <span class="lc-agent">{COST.ledger.columns[3]}</span>
            <span class="lc-route">{COST.ledger.columns[4]}</span>
            <span class="lc-cost">{COST.ledger.columns[5]}</span>
          </div>
          <div class="ledger-rows">
            {
              COST.ledger.rows.map((row, i) => (
                <div class="ledger-row" style={`--i:${i}`}>
                  <span class="lc-time">{row.time}</span>
                  <span class="lc-user">{row.user}</span>
                  <span class="lc-team">{row.team}</span>
                  <span class="lc-agent">{row.agent}</span>
                  <span class="lc-route">{row.route}</span>
                  <span class="lc-cost">{row.cost}</span>
                </div>
              ))
            }
          </div>
          <div class="ledger-totals">
            {
              COST.ledger.totals.map((total) => (
                <div class:list={['ledger-total', { 'is-accent': total.accent }]}>
                  <span class="total-label">{total.label}</span>
                  <span class="total-value">{total.value}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="layers reveal">
          {
            COST.layers.map((layer) => (
              <div class="layer">
                <div class="layer-name">{layer.name}</div>
                <p class="layer-body">{layer.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Tenancy: your cloud, the trust close. Resolves the boundary thesis: the
         boundary is yours, not Codeflare's. -->
    <section id={TENANCY.id} class="section section--alt">
      <div class="container">
        <div class="split">
          <div class="section-head reveal" style="margin-bottom:0">
            <h2>{TENANCY.title}</h2>
            <p class="lead" set:html={TENANCY.lead} />
          </div>
          <div class="split-aside reveal">
            <ul class="checklist checklist--mono">
              {
                TENANCY.checklist.map((item) => (
                  <li>
                    {item.label}
                    <span>{item.note}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- The payoff band: the platform, placed after the governance spine so
         capability reads as the payoff the boundary makes safe. -->
    <section id={PLATFORM.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{PLATFORM.kicker}</p>
          <h2>{PLATFORM.title}</h2>
          <p class="lead">{PLATFORM.lead}</p>
        </div>
        <div class="card-grid card-grid--2" data-stagger>
          {
            PLATFORM.cards.map((card) => (
              <div class="card">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <div class="agent-chips reveal" aria-label="Supported coding agents">
          {AGENTS.map((agent) => <span>{agent}</span>)}
        </div>
      </div>
    </section>

    <!-- Runs in a browser: the calm tail, deliberately quieter than the
         instrument stations so the page decompresses. -->
    <section id={BROWSER.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <h2>{BROWSER.title}</h2>
          <p class="lead">{BROWSER.lead}</p>
        </div>
        <div class="feature-grid feature-grid--3" data-stagger>
          {
            BROWSER.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ: the answers, up front (the four governance questions lead). -->
    <section id={FAQ_SECTION.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <h2>{FAQ_SECTION.title}</h2>
        </div>
        <div class="faq reveal">
          {
            FAQ_ITEMS.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p class="faq-answer">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id={CONTACT_FORM.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <h2>{CONTACT_FORM.title}</h2>
        </div>
        <ContactForm />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
