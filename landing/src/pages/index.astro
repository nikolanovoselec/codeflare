---
/**
 * The Codeflare enterprise landing page. Sections compose typed content from
 * src/content/site.ts; each section uses a distinct layout family. One
 * terminal (the hero), one diagram (the security boundary), one code block
 * (the review pipeline). Calm, sans prose, mobile-first.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { APP_LINKS } from '../config';
import {
  NAV_LINKS,
  AGENTS,
  STATS,
  SHIFT,
  METHOD,
  SECURITY,
  BOUNDARY_FLOW,
  OPERATIONS,
  BROWSER,
  PLATFORM,
  PIPELINE,
  COST,
  TENANCY,
  FAQ_SECTION,
  FAQ_ITEMS,
  CONTACT_FORM,
} from '../content/site';
---

<BaseLayout>
  <nav class="site-nav">
    <div class="container">
      <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"></span>codeflare</a>
      <div class="nav-right">
        <ul class="nav-links">
          {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <a class="btn btn-ghost btn-sm nav-signin" href={APP_LINKS.signIn}>Sign in</a>
      </div>
    </div>
  </nav>

  <main id="top">
    <Hero />

    <!-- Stat band -->
    <section class="section section--alt">
      <div class="container">
        <div class="stats" data-stagger>
          {
            STATS.map((stat) => (
              <div class="stat">
                <div class="stat-value">{stat.value}</div>
                <p class="stat-label">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The shift -->
    <section id={SHIFT.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <h2>{SHIFT.title}</h2>
          <p class="lead" set:html={SHIFT.lead} />
        </div>
        <div class="compare reveal">
          <div class="compare-col is-old">
            <h3>{SHIFT.assistant.title} <span class="compare-tag">{SHIFT.assistant.tag}</span></h3>
            <ul class="compare-list">{SHIFT.assistant.points.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="compare-col is-new">
            <h3>{SHIFT.engine.title} <span class="compare-tag">{SHIFT.engine.tag}</span></h3>
            <ul class="compare-list">{SHIFT.engine.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- The method: spec-driven development, enforced -->
    <section id={METHOD.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{METHOD.kicker}</p>
          <h2>{METHOD.title}</h2>
          <p class="lead">{METHOD.lead}</p>
        </div>
        <div class="card-grid card-grid--3" data-stagger>
          {
            METHOD.pillars.map((card) => (
              <div class="card">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <div class="code-block method-trace reveal">
          {
            METHOD.trace.map((line) => (
              <span
                class:list={[
                  'cl',
                  { 'cl-head': line.kind === 'head', 'cl-ok': line.kind === 'ok', 'cl-warn': line.kind === 'warn' },
                ]}
              >
                {line.strong && <strong>{line.strong}</strong>}
                {line.text}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Security -->
    <section id={SECURITY.id} class="section">
      <div class="container">
        <div class="split">
          <div class="section-head reveal" style="margin-bottom:0">
            <p class="kicker">{SECURITY.kicker}</p>
            <h2>{SECURITY.title}</h2>
            <p class="lead">{SECURITY.lead}</p>
            <p class="micro-cta">
              <a href="#contact" data-topic="security-compliance">{SECURITY.microCta}</a>
            </p>
          </div>
          <div class="split-aside reveal">
            <div class="flow">
              {
                BOUNDARY_FLOW.map((node, i) => (
                  <Fragment>
                    <div class:list={['flow-node', { 'is-accent': node.accent }]}>
                      {node.label}
                      <small>{node.sub}</small>
                    </div>
                    {i < BOUNDARY_FLOW.length - 1 && (
                      <div class="flow-arrow">{node.edge && <span>{node.edge}</span>}</div>
                    )}
                  </Fragment>
                ))
              }
            </div>
          </div>
        </div>
        <div class="card-grid card-grid--2" data-stagger>
          {
            SECURITY.cards.map((card) => (
              <div class="card">
                <span class="card-tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Operations: the same governed agents, beyond code into infrastructure.
         Plain (not --alt) so it flows out of the plain Security section and lets
         Browser resume the alternating band rhythm. -->
    <section id={OPERATIONS.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{OPERATIONS.kicker}</p>
          <h2>{OPERATIONS.title}</h2>
          <p class="lead">{OPERATIONS.lead}</p>
        </div>
        <div class="card-grid card-grid--3" data-stagger>
          {
            OPERATIONS.cards.map((card) => (
              <div class="card">
                <span class="card-tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Runs in a browser -->
    <section id={BROWSER.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <h2>{BROWSER.title}</h2>
          <p class="lead">{BROWSER.lead}</p>
        </div>
        <div class="feature-grid feature-grid--3" data-stagger>
          {
            BROWSER.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The platform -->
    <section id={PLATFORM.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{PLATFORM.kicker}</p>
          <h2>{PLATFORM.title}</h2>
          <p class="lead">{PLATFORM.lead}</p>
        </div>
        <div class="card-grid card-grid--2" data-stagger>
          {
            PLATFORM.cards.map((card) => (
              <div class="card">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <div class="agent-chips reveal" aria-label="Supported coding agents">
          {AGENTS.map((agent) => <span>{agent}</span>)}
        </div>
      </div>
    </section>

    <!-- Your pipeline -->
    <section id={PIPELINE.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <h2>{PIPELINE.title}</h2>
          <p class="lead">{PIPELINE.lead}</p>
        </div>
        <div class="split">
          <div class="point-list reveal">
            {
              PIPELINE.cards.map((card) => (
                <div class="point-item">
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                </div>
              ))
            }
          </div>
          <div class="split-aside reveal">
            <div class="code-block">
              {
                PIPELINE.snippet.map((line) => (
                  <span class:list={['cl', { 'cl-head': line.kind === 'head', 'cl-ok': line.kind === 'ok' }]}>
                    {line.strong && <strong>{line.strong}</strong>}
                    {line.text}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost -->
    <section id={COST.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">{COST.kicker}</p>
          <h2>{COST.title}</h2>
          <p class="lead">{COST.lead}</p>
        </div>
        <div class="layers reveal">
          {
            COST.layers.map((layer) => (
              <div class="layer">
                <div class="layer-name">{layer.name}</div>
                <p class="layer-body">{layer.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Your cloud -->
    <section id={TENANCY.id} class="section section--alt">
      <div class="container">
        <div class="split">
          <div class="section-head reveal" style="margin-bottom:0">
            <h2>{TENANCY.title}</h2>
            <p class="lead" set:html={TENANCY.lead} />
          </div>
          <div class="split-aside reveal">
            <ul class="checklist">
              {
                TENANCY.checklist.map((item) => (
                  <li>
                    {item.label}
                    <span>{item.note}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id={FAQ_SECTION.id} class="section">
      <div class="container">
        <div class="section-head reveal">
          <h2>{FAQ_SECTION.title}</h2>
        </div>
        <div class="faq reveal">
          {
            FAQ_ITEMS.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p class="faq-answer">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id={CONTACT_FORM.id} class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <h2>{CONTACT_FORM.title}</h2>
        </div>
        <ContactForm />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
