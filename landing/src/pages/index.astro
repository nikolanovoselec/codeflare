---
/**
 * The Codeflare enterprise landing page: one governed run threaded across the
 * whole page. A single pull request (the spine, REQ-PAY-014 / AC3 / PR #207)
 * is followed from intent to merge, and the proof artifacts are camera angles
 * on it: the hero terminal opens it, the enforcement gate catches it drifting,
 * the boundary + egress strip show where its traffic may go, the context terminal
 * shows how it reads the web safely, the review board judges it in parallel,
 * and the cost ledger is its bill closing on zero unattributed. Governance
 * carries the page; the platform capability lands afterwards as the payoff the
 * boundary makes safe. Calm, sans prose, mono for proof, mobile-first.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureTerminals from '../components/FeatureTerminals.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { APP_LINKS } from '../config';
import {
  NAV_LINKS,
  AGENTS,
  SPINE,
  SHIFT,
  METHOD,
  LEGACY,
  SECURITY,
  EGRESS,
  OPERATIONS,
  BROWSER,
  PLATFORM,
  CONTEXT,
  PIPELINE,
  COST,
  TENANCY,
  FAQ_SECTION,
  FAQ_ITEMS,
  CONTACT_FORM,
  DOGFOOD,
  ORCHESTRATION,
  TRUSTED,
} from '../content/site';
---

<BaseLayout>
  <nav class="site-nav">
    <div class="container">
      <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"></span>codeflare</a>
      <div class="nav-right">
        <ul class="nav-links">
          {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <a class="btn btn-ghost btn-sm nav-signin" href={APP_LINKS.signIn}>Sign in</a>
      </div>
    </div>
  </nav>

  <main id="top">
    <Hero />

    <!-- The shift: the assistant-to-engine leap shown the way the page trades,
         as terminals. Four short feature terminals (gateway, session, review,
         spec) replace the old stat band and the old checkmark comparison. -->
    <section id={SHIFT.id} class="section" data-station={SHIFT.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{SHIFT.station.n}</span><span class="station-label">{SHIFT.station.label}</span></p>
          <h2>{SHIFT.title}</h2>
          <p class="lead" set:html={SHIFT.lead} />
        </div>
        <FeatureTerminals />
      </div>
    </section>

    <!-- Station 01, Method: spec-driven development, enforced. The gate (the
         receipt) precedes the prose, and the two pillars read as plain
         label-and-prose clauses; the page-wide station spine now carries the
         numbering, so the method body has no numbered clauses of its own. -->
    <section id={METHOD.id} class="section section--alt" data-station={METHOD.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{METHOD.station.n}</span><span class="station-label">{METHOD.station.label}</span></p>
          <h2>{METHOD.title}</h2>
          <p class="lead">{METHOD.lead}</p>
        </div>
        <!-- Self-healing enforcement gate: a drift caught and corrected at the PR
             boundary. Static markup is the resolved state; data-proof replays the
             fail -> correct -> pass sequence once on scroll-in. The only place an
             agent visibly fails, which is the point. The gate caption is the
             terminal's in-chrome foot, matching every other terminal on the page. -->
        <div class="terminal gate reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="gate-req">{METHOD.gate.req}</span>
            <span class="gate-crit">{METHOD.gate.criterion}</span>
            <span class="gate-pr">{METHOD.gate.pr}</span>
          </div>
          <div class="gate-steps" data-roll>
            {
              METHOD.gate.steps.map((step, i) => (
                <div class:list={['gate-step', `is-${step.state}`]} style={`--i:${i}`}>
                  <span class="gate-actor">{step.actor}</span>
                  <span class="gate-state">
                    {step.state === 'fail' ? 'failed' : step.state === 'work' ? 'correcting' : 'passed'}
                  </span>
                  <span class="gate-text">{step.text}</span>
                </div>
              ))
            }
          </div>
          <div class="terminal-foot tf-static"><span class="tf-seg">{METHOD.gate.caption}</span></div>
        </div>
        <ol class="method-clauses" data-stagger>
          {
            METHOD.pillars.map((card) => (
              <li>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Station 02, Legacy: legacy code, made safe for agents. /sdd init turns a
         legacy codebase into a spec-driven baseline and /sdd clean realigns a
         drifted spec, in the page's existing terminal idiom (context grammar). -->
    <section id={LEGACY.id} class="section" data-station={LEGACY.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{LEGACY.station.n}</span><span class="station-label">{LEGACY.station.label}</span></p>
          <h2>{LEGACY.title}</h2>
          <p class="lead">{LEGACY.lead}</p>
        </div>
        <div class="terminal feature-terminal context-terminal reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="terminal-title">{LEGACY.terminal.title}</span>
          </div>
          <div class="terminal-body">
            {LEGACY.terminal.lines.map((line, i) => <span class={`t-line t-${line.tone}`} style={`--i:${i}`}>{line.text}</span>)}
          </div>
          <div class="terminal-foot tf-static">
            <span class="tf-seg">{LEGACY.terminal.foot}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Station 03, Security: zero trust is the architecture. One merged receipt:
         the boundary's approved and impossible paths, a thin in-terminal divider,
         then one real call obeying the boundary, closing on a single in-chrome
         foot (security + egress folded into one terminal, #7). -->
    <section id={SECURITY.id} class="section section--alt" data-station={SECURITY.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{SECURITY.station.n}</span><span class="station-label">{SECURITY.station.label}</span></p>
          <h2>{SECURITY.title}</h2>
          <p class="lead">{SECURITY.lead}</p>
          <p class="micro-cta">
            <a href="#contact" data-topic="security-compliance">{SECURITY.microCta}</a>
          </p>
        </div>
        <!-- Boundary + egress as one terminal: the approved paths and the paths
             the architecture makes impossible (rolled in), a divider, then one
             outbound model call obeying the boundary (the DLP redaction is the
             one amber beat), under a single normalized in-chrome foot. -->
        <div class="terminal gate boundary reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="gate-req">{SECURITY.boundary.title}</span>
          </div>
          <div class="gate-steps" data-roll>
            {
              SECURITY.boundary.rows.map((row, i) => (
                <div class:list={['gate-step', `is-${row.state}`]} style={`--i:${i}`}>
                  <span class="gate-actor">{row.actor}</span>
                  <span class="gate-state">{row.label}</span>
                  <span class="gate-text">{row.text}</span>
                </div>
              ))
            }
          </div>
          <div class="gate-subhead">one call leaves the boundary · {EGRESS.call}</div>
          <div class="gate-steps">
            {
              EGRESS.rows.map((row, i) => (
                <div class:list={['gate-step', `is-${row.state}`]} style={`--i:${i}`}>
                  <span class="gate-actor">{row.actor}</span>
                  <span class="gate-state">{row.label}</span>
                  <span class="gate-text">{row.text}</span>
                </div>
              ))
            }
          </div>
          <div class="terminal-foot tf-static"><span class="tf-seg">{SECURITY.boundary.caption}</span></div>
        </div>
        <!-- Operations folded into the boundary station as sub-content: the same
             governed agents beyond code into infrastructure, on the same boundary,
             so it visually belongs to station 04 instead of floating un-numbered. -->
        <div class="section-head substation reveal">
          <h3>{OPERATIONS.title}</h3>
          <p class="lead">{OPERATIONS.lead}</p>
        </div>
        <div class="feature-grid feature-grid--2" data-stagger>
          {
            OPERATIONS.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Station 04, Context: the open web, rendered clean, never trusted. One
         real fetch from the spine run shown as a proof terminal. -->
    <section id={CONTEXT.id} class="section" data-station={CONTEXT.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{CONTEXT.station.n}</span><span class="station-label">{CONTEXT.station.label}</span></p>
          <h2>{CONTEXT.title}</h2>
          <p class="lead">{CONTEXT.lead}</p>
        </div>
        <div class="terminal feature-terminal context-terminal reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="terminal-title">{CONTEXT.terminal.title}</span>
          </div>
          <div class="terminal-body">
            {CONTEXT.terminal.lines.map((line, i) => <span class={`t-line t-${line.tone}`} style={`--i:${i}`}>{line.text}</span>)}
          </div>
          <div class="terminal-foot tf-static">
            <span class="tf-seg">{CONTEXT.terminal.foot}</span>
          </div>
        </div>

        <!-- Substation of station 05: the other Browser Run surface. The same
             throwaway browser the agent reads as markdown, it also DRIVES, an
             agent-steered semantic e2e at a mobile viewport that judges the
             deployed app against intent. The deny line is a real finding this
             repo's own landing QA caught. Belongs to station 05, not floating. -->
        <div class="section-head substation reveal">
          <h3>{CONTEXT.e2e.heading}</h3>
          <p class="lead">{CONTEXT.e2e.lead}</p>
        </div>
        <div class="terminal feature-terminal context-terminal reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="terminal-title">{CONTEXT.e2e.terminal.title}</span>
          </div>
          <div class="terminal-body">
            {CONTEXT.e2e.terminal.lines.map((line, i) => <span class={`t-line t-${line.tone}`} style={`--i:${i}`}>{line.text}</span>)}
          </div>
          <div class="terminal-foot tf-static">
            <span class="tf-seg">{CONTEXT.e2e.terminal.foot}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Station 05, Pipeline: the parallel review board. Six specialist agents
         on one diff at once, two catching a finding and re-proving it, all
         converging on one human triage gate. "One engineer, many agents" made
         literal. -->
    <section id={PIPELINE.id} class="section section--alt" data-station={PIPELINE.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{PIPELINE.station.n}</span><span class="station-label">{PIPELINE.station.label}</span></p>
          <h2>{PIPELINE.title}</h2>
          <p class="lead">{PIPELINE.lead}</p>
        </div>

        <div class="terminal review-board reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="board-pr-id">{SPINE.pr} · {SPINE.service}</span>
            <span class="board-pr-trigger">{PIPELINE.trigger}</span>
          </div>
          <div class="board-dispatch" aria-hidden="true">{PIPELINE.dispatch}</div>
          <div class="board-lanes" data-roll>
            {
              PIPELINE.lanes.map((lane, i) => (
                <div class:list={['board-lane', `is-${lane.result}`]} style={`--i:${i}`}>
                  <span class="lane-agent">{lane.agent}</span>
                  <span class="lane-track" aria-hidden="true">
                    <span class="lane-step">queued</span>
                    <span class="lane-step">running</span>
                    {lane.result === 'finding' && <span class="lane-step is-finding">finding</span>}
                    {lane.result === 'finding' && <span class="lane-step is-fixed">fixed</span>}
                    <span class="lane-step is-verified">verified</span>
                  </span>
                  <span class="lane-note">{lane.note}</span>
                </div>
              ))
            }
          </div>
          <div class="board-verdict">
            <span class="verdict-title">{PIPELINE.verdict.title}</span>
            <span class="verdict-note">{PIPELINE.verdict.note}</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Station 07, Orchestration: the operator's live view of the same review,
         relocated out from under the board into its own station and made dynamic.
         orch.ts ticks each agent's tool-use / token counters and advances its
         activity line so it reads as a running feed, not a frozen screenshot.
         data-proof reveals the lines once on scroll-in; data-orch arms the live
         ticking. Reduced motion / no JS: the resolved values stand. -->
    <section id={ORCHESTRATION.id} class="section" data-station={ORCHESTRATION.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{ORCHESTRATION.station.n}</span><span class="station-label">{ORCHESTRATION.station.label}</span></p>
          <h2>{ORCHESTRATION.title}</h2>
          <p class="lead">{ORCHESTRATION.lead}</p>
        </div>
        <div class="terminal orch reveal" data-proof data-orch>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="board-pr-id">{SPINE.pr} · {SPINE.service}</span>
            <span class="board-pr-trigger">live</span>
          </div>
          <div class="terminal-body">
            <span class="t-line orch-head"><span class="orch-dot" aria-hidden="true">●</span> {ORCHESTRATION.header}… <span class="orch-hint">({ORCHESTRATION.hint})</span></span>
            {
              ORCHESTRATION.agents.map((agent, i) => {
                const last = i === ORCHESTRATION.agents.length - 1;
                return (
                  <Fragment>
                    <span class="t-line orch-agent-line" data-orch-agent data-activities={JSON.stringify(agent.activities)}><span class="orch-branch" aria-hidden="true">{last ? '└ ' : '├ '}</span><span class="orch-agent">{agent.agent}</span><span class="orch-meta"> ({agent.task}) · <span data-orch-tooluses>{agent.toolUses}</span> tool uses · <span data-orch-tokens>{agent.tokens.toFixed(1)}</span>k tokens</span></span>
                    <span class="t-line orch-sub"><span class="orch-branch" aria-hidden="true">{last ? '  └ ' : '│ └ '}</span><span data-orch-activity>{agent.activities[0]}</span></span>
                  </Fragment>
                );
              })
            }
            <span class="t-line orch-hint">({ORCHESTRATION.footHint})</span>
          </div>
          <div class="terminal-foot tf-static"><span class="tf-seg">{ORCHESTRATION.foot}</span></div>
        </div>
      </div>
    </section>

    <!-- Station 06, Cost: no unattributed spend. The ledger is the literal bill
         for the spine run, closing on zero unattributed. -->
    <section id={COST.id} class="section section--alt" data-station={COST.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{COST.station.n}</span><span class="station-label">{COST.station.label}</span></p>
          <h2>{COST.title}</h2>
          <p class="lead">{COST.lead}</p>
        </div>
        <!-- Attribution ledger: every line carries an owner; the last total
             reads zero unattributed. The rows are a sample of the run; the
             totals cover all of it (the sample note reconciles the two). -->
        <div class="terminal ledger reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="ledger-meta-id">{COST.ledger.meta}</span>
            <span class="ledger-meta-sample">{COST.ledger.sample}</span>
          </div>
          <div class="ledger-head" aria-hidden="true">
            <span class="lc-time">{COST.ledger.columns[0]}</span>
            <span class="lc-user">{COST.ledger.columns[1]}</span>
            <span class="lc-team">{COST.ledger.columns[2]}</span>
            <span class="lc-agent">{COST.ledger.columns[3]}</span>
            <span class="lc-route">{COST.ledger.columns[4]}</span>
            <span class="lc-cost">{COST.ledger.columns[5]}</span>
          </div>
          <div class="ledger-rows" data-roll>
            {
              COST.ledger.rows.map((row, i) => (
                <div class="ledger-row" style={`--i:${i}`}>
                  <span class="lc-time">{row.time}</span>
                  <span class="lc-user">{row.user}</span>
                  <span class="lc-team">{row.team}</span>
                  <span class="lc-agent">{row.agent}</span>
                  <span class="lc-route">{row.route}</span>
                  <span class="lc-cost">{row.cost}</span>
                </div>
              ))
            }
          </div>
          <div class="ledger-totals">
            {
              COST.ledger.totals.map((total) => (
                <div class:list={['ledger-total', { 'is-accent': total.accent }]}>
                  <span class="total-label">{total.label}</span>
                  <span class="total-value">{total.value}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="feature-grid feature-grid--3" data-stagger>
          {
            COST.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <!-- Tenancy folded into the spend station as sub-content: the spend and
             the cloud it lands in are one story (your account), so it belongs to
             station 08 instead of floating un-numbered. -->
        <div class="split substation">
          <div class="section-head reveal" style="margin-bottom:0">
            <h3>{TENANCY.title}</h3>
            <p class="lead" set:html={TENANCY.lead} />
          </div>
          <div class="split-aside reveal">
            <dl class="manifest">
              {
                TENANCY.manifest.map((item) => (
                  <div class="manifest-row">
                    <dt>{item.label}</dt>
                    <dd>{item.note}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Station 09, Platform: the payoff band, after the governance spine so
         capability reads as the payoff the boundary makes safe. The browser-runs-
         everywhere story folds in as sub-content so it belongs to the station. -->
    <section id={PLATFORM.id} class="section" data-station={PLATFORM.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{PLATFORM.station.n}</span><span class="station-label">{PLATFORM.station.label}</span></p>
          <h2>{PLATFORM.title}</h2>
          <p class="lead">{PLATFORM.lead}</p>
        </div>
        <div class="feature-grid feature-grid--2" data-stagger>
          {
            PLATFORM.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
        <div class="agent-chips reveal" aria-label="Supported coding agents">
          {AGENTS.map((agent) => <span>{agent}</span>)}
        </div>
        <!-- Runs-everywhere folded into the platform station as sub-content. -->
        <div class="section-head substation reveal">
          <h3>{BROWSER.title}</h3>
          <p class="lead">{BROWSER.lead}</p>
        </div>
        <div class="feature-grid feature-grid--3" data-stagger>
          {
            BROWSER.cards.map((card) => (
              <div class="feature-col">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Station 10, Answers: the FAQ, the four governance questions lead. -->
    <!-- Station 10, Proof: this very page is a Codeflare-governed requirement.
         The proof is real (the @impl / @test anchors live in sdd/spec/landing.md),
         the Swiss Post customer band folds in as its social-proof tail. It sits
         before the FAQ so the dogfood proof lands before the closing answers. -->
    <section id={DOGFOOD.id} class="section section--alt" data-station={DOGFOOD.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{DOGFOOD.station.n}</span><span class="station-label">{DOGFOOD.station.label}</span></p>
          <h2>{DOGFOOD.title}</h2>
          <p class="lead">{DOGFOOD.lead}</p>
        </div>
        <div class="terminal dogfood-terminal reveal" data-proof>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="terminal-title">{DOGFOOD.terminalTitle}</span>
          </div>
          <div class="terminal-body">
            <span class={`t-line t-${DOGFOOD.lines[0].tone}`} style="--i:0">{DOGFOOD.lines[0].text}</span>
            <div data-roll>
              {DOGFOOD.lines.slice(1, -1).map((line, i) => <span class={`t-line t-${line.tone}`} style={`--i:${i + 1}`}>{line.text}</span>)}
            </div>
            <span class={`t-line t-${DOGFOOD.lines[DOGFOOD.lines.length - 1].tone}`} style={`--i:${DOGFOOD.lines.length - 1}`}>{DOGFOOD.lines[DOGFOOD.lines.length - 1].text}</span>
          </div>
          <div class="terminal-foot tf-static"><span class="tf-seg">{DOGFOOD.foot}</span></div>
        </div>
        <p class="micro-cta dogfood-cta reveal">
          <a href={DOGFOOD.cta.href} target="_blank" rel="noopener">{DOGFOOD.cta.label}</a>
        </p>
        <!-- Trusted-by folded into the proof station: a single national-institution
             customer as the social-proof tail of the dogfood argument, a quiet
             band (belongs to station 10). The logo links to the customer site. -->
        <div class="trusted-section substation">
          <p class="trusted-label reveal">{TRUSTED.label}</p>
          <div class="trusted-logos reveal">
            <a
              class="trusted-logo-link"
              href={TRUSTED.logo.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${TRUSTED.logo.name} (opens in a new tab)`}
            >
              <img
                class="trusted-logo"
                src={TRUSTED.logo.src}
                alt={TRUSTED.logo.alt}
                width="72"
                height="72"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id={FAQ_SECTION.id} class="section" data-station={FAQ_SECTION.station.n}>
      <div class="container">
        <div class="section-head reveal">
          <p class="station-marker"><span class="station-n">{FAQ_SECTION.station.n}</span><span class="station-label">{FAQ_SECTION.station.label}</span></p>
          <h2>{FAQ_SECTION.title}</h2>
        </div>
        <div class="faq reveal">
          {
            FAQ_ITEMS.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p class="faq-answer">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id={CONTACT_FORM.id} class="section section--alt">
